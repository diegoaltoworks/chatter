{
  // Covers test/api-surface.test.ts and test/integration/**, so a
  // ChatterConfig/createServer shape change fails compilation here instead
  // of only at runtime the next time someone touches those files.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["*.test.ts", "integration/*.test.ts"]
}
