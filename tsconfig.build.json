{
  // Declaration-emit config. Narrower than tsconfig.json (which is the
  // typecheck config and deliberately covers tests and build scripts): the
  // published `dist` must contain only the shipped surface, so test files,
  // their fixtures, and the widget package's own tests/examples are excluded
  // from the emit program. See scripts/pack-exports.ts for the check that
  // enforces this against the packed tarball.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/client/dist",
    "src/client/node_modules",
    "src/client/examples",
    "src/client/__tests__",
    "src/**/*.test.ts",
    "src/**/__fixtures__/**"
  ]
}
