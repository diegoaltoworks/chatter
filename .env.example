# OpenAI Configuration
OPENAI_API_KEY=sk-...

# Database Configuration (Turso)
TURSO_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Bot Configuration
BOT_NAME=Chatter
BOT_PERSON_NAME=Admin
BOT_PUBLIC_URL=http://localhost:8181
BOT_DESCRIPTION=AI chatbot powered by Chatter

# Authentication (optional - choose one or more)
# Clerk
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# JWT
JWT_SECRET=your-secret-key-here

# Security
CHATTER_SECRET=your-secret-for-api-keys
ALLOWED_ORIGINS=*

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Directories (relative to project root)
KNOWLEDGE_DIR=./knowledge
PROMPTS_DIR=./prompts

# Channels (optional - see docs/channels.md, docs/telegram.md, docs/matrix.md)
# WhatsApp (unofficial, Baileys-based - see docs/channels.md)
WA_SESSION_SECRET=your-session-encryption-secret
WA_SESSION_IDS=default
WA_CHAT_ALLOWLIST=

# Telegram (official Bot API - see docs/telegram.md)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_GROUPS=
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret

# Matrix (official client-server API - see docs/matrix.md)
MATRIX_HOMESERVER_URL=https://matrix.org
MATRIX_ACCESS_TOKEN=your-matrix-access-token
MATRIX_ROOMS=
