{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "types": ["bun-types"]
  },
  // Typecheck scope: everything we author, including tests and build scripts.
  // Declaration emit uses the narrower tsconfig.build.json instead, so nothing
  // here leaks into the published `dist`.
  "include": ["src/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist", "src/client/dist", "src/client/node_modules"]
}
